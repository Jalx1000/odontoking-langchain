# ============================================================
# Odontoking Agent — Environment Configuration
# Copy this file to .env.development / .env.production
# NEVER commit real credentials to git.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development           # development | staging | production | test
PROJECT_NAME="Odontoking"
VERSION=1.0.0
DEBUG=false
API_V1_STR=/api/v1
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=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
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2
# MAX_TOKENS=2000
MAX_LLM_CALL_RETRIES=3
LLM_TOTAL_TIMEOUT=60          # seconds — hard cap for the full LLM+tools loop

# ── Long-term memory (mem0 + pgvector) ──────────────────────
ODONTOKING_MEMORY_ENABLED=false
LONG_TERM_MEMORY_MODEL=gpt-4o-mini
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=odontoking_db
POSTGRES_USER=odontoking
POSTGRES_PASSWORD=change_me
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ── Valkey / Redis ──────────────────────────────────────────
# Leave VALKEY_HOST empty to use the in-memory fallback.
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_DB=0
VALKEY_PASSWORD=
VALKEY_MAX_CONNECTIONS=20
CACHE_TTL_SECONDS=60

# ── WhatsApp Cloud API (Meta) ────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx

# ── Message buffer (debounce + worker) ──────────────────────
BUFFER_ENABLED=true
BUFFER_WINDOW_SECONDS=3.0     # seconds to accumulate messages before processing
BUFFER_MAX_MESSAGES=10        # max messages queued per user

# ── Odontoking / Sofopolis CRM API ──────────────────────────
ODONTOKING_API_URL=https://odontoking.sofopolis.com
ODONTOKING_API_TOKEN=your_api_token_here

# ── Langfuse (LLM observability) ────────────────────────────
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ── JWT (API REST auth) ──────────────────────────────────────
JWT_SECRET_KEY=change_me_to_a_random_64_char_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# ── Alert notifications (SMTP email) ────────────────────────
# Alerts fire on every logger.error() / logger.exception(), debounced.
MAIL_HOST=mail.sofopolis.com
MAIL_PORT=465                 # 465 = SSL, 587 = STARTTLS
MAIL_USERNAME=alerts@sofopolis.com
MAIL_PASSWORD=change_me
MAIL_FROM_ADDRESS=alerts@sofopolis.com
MAIL_TO_ADDRESS=dev@sofopolis.com   # who receives the alerts
NOTIFICATION_COOLDOWN_SECONDS=300   # 5 min between same-type alerts

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json (production) | console (development)
LOG_DIR=logs

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_DEFAULT="200 per day,50 per hour"
RATE_LIMIT_CHAT="30 per minute"
RATE_LIMIT_CHAT_STREAM="20 per minute"
RATE_LIMIT_MESSAGES="50 per minute"
RATE_LIMIT_LOGIN="20 per minute"
RATE_LIMIT_REGISTER="10 per hour"

# ── Evaluation (Langfuse evals) ──────────────────────────────
EVALUATION_LLM=gpt-4o
EVALUATION_BASE_URL=https://api.openai.com/v1
EVALUATION_API_KEY=sk-...     # defaults to OPENAI_API_KEY if empty
EVALUATION_SLEEP_TIME=10

# ── Session naming ───────────────────────────────────────────
SESSION_NAMING_ENABLED=true

# ── Sharemedata Calendar (optional integration) ───────────────
SHAREMEDATA_API_URL=http://gamma.sharemedata.com:3000
SHAREMEDATA_API_KEY=

# ── Profiling (DEBUG mode only) ──────────────────────────────
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0
