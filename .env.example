# ============================================================
# Agencia - Plataforma Multi-Tenant de Agentes IA
# ============================================================
# Instrucciones:
#   1. Copia este archivo: cp .env.example .env.development
#   2. Rellena los valores marcados con <CHANGE_ME>
#   3. NUNCA subas credenciales reales a git
#
# Generar claves:
#   JWT_SECRET_KEY:  python -c "import secrets; print(secrets.token_hex(32))"
#   ADMIN_API_KEY:   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================


# ── Aplicación ───────────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production | test
PROJECT_NAME="Sofopolis Agents"
VERSION=1.0.0
DEBUG=false
API_V1_STR=/api/v1
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"


# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=<CHANGE_ME>
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=2000
MAX_LLM_CALL_RETRIES=3
LLM_TOTAL_TIMEOUT=60          # segundos - tope duro para LLM + tools
LLM_REQUEST_TIMEOUT=30        # segundos - timeout por request a OpenAI (falla rápido y reintenta dentro del presupuesto total)


# ── Modo de agendamiento ─────────────────────────────────────────────────────
# INTAKE_ENABLED=true  → el intake determinista guía los pasos 1-6 (por defecto).
# AI_BOOKING_ENABLED=true → la IA (grafo LangGraph) hace TODO el agendamiento y se
#   omite el intake determinista. false = agendamiento por intake.
INTAKE_ENABLED=true
AI_BOOKING_ENABLED=false

# ── Memoria a largo plazo (mem0 + pgvector) ──────────────────────────────────
ODONTOKING_MEMORY_ENABLED=false
LONG_TERM_MEMORY_MODEL=gpt-4o-mini
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory


# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agents_db
POSTGRES_USER=agents
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10


# ── Valkey / Redis ───────────────────────────────────────────────────────────
# Dejar VALKEY_HOST vacío para usar caché in-memory (desarrollo sin Redis)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_DB=0
VALKEY_PASSWORD=
VALKEY_MAX_CONNECTIONS=20
CACHE_TTL_SECONDS=60


# ── RabbitMQ / CloudAMQP (Fase 5 - opcional) ────────────────────────────────
# Activar para broker enterprise con DLQ nativa, UI de colas y alta disponibilidad.
# Prioridad: RabbitMQ > Redis Streams > InMemory
#
# Instalar dependencia: uv add aio-pika --optional rabbitmq
#
# Formato:  amqp://user:password@host:5672/vhost
#           amqps://user:password@host:5671/vhost  (TLS - recomendado en prod)
#
# CloudAMQP: https://www.cloudamqp.com
#   - Little Lemur (gratis): 1M mensajes/mes, 1 conexión concurrente
#   - Little Pony (~$19/mes): mensajes ilimitados, recomendado para Kohlberg nacional
#
# RABBITMQ_URL=amqps://<user>:<password>@<host>.cloudamqp.com/<vhost>
RABBITMQ_URL=


# ── Seguridad y Admin Panel ──────────────────────────────────────────────────
# Clave estática para acceder a /api/v1/admin/* (header X-Admin-Key)
ADMIN_API_KEY=<CHANGE_ME>

# Clave interna para que los servicios de agentes reporten uso a POST /internal/usage
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=

# Clave Fernet para cifrar tokens de tenants en la DB
# Si no se configura, los tokens se almacenan en texto plano (solo para dev local)
ENCRYPTION_KEY=

# TTL del caché Redis para configuración de tenants (segundos)
TENANT_CACHE_TTL=300


# ── JWT (API REST auth - panel web) ─────────────────────────────────────────
JWT_SECRET_KEY=<CHANGE_ME>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30


# ── Message Buffer (debounce + worker) ──────────────────────────────────────
BUFFER_ENABLED=true
BUFFER_WINDOW_SECONDS=3.0     # segundos de acumulación antes de procesar
BUFFER_MAX_MESSAGES=10        # máximo de mensajes en cola por usuario


# ── Worker Process (un servicio Railway por tenant) ──────────────────────────
# Solo necesario en el servicio worker, NO en el servicio API
# WORKER_TENANT=odontoking     # slug del tenant que atiende este worker
# WORKER_CONSUMER_NAME=        # nombre único del consumer (default: hostname)


# ── Gateway de envío de WhatsApp ────────────────────────────────────────────
# "meta"     → envía/recibe directo por Meta Cloud API (default, config de abajo)
# "sofo-crm" → enruta por el CRM intermediario (Krayin); el CRM entrega vía Kommo/Cloud API.
#              El inbound llega a POST /api/v1/whatsapp/... queda inactivo y en su lugar
#              el CRM postea a  POST /api/v1/crm/webhook.
WHATSAPP_GATEWAY=meta
# Sólo para WHATSAPP_GATEWAY=sofo-crm:
CRM_BASE_URL=https://imprimir.sofopolis.com
# Bearer que el CRM manda en cada evento message.received; el agente lo valida.
WHATSAPP_AGENT_TOKEN=<CHANGE_ME>
# Token Sanctum de un usuario dedicado del CRM (obtenido una vez con POST /api/v1/login).
CRM_API_KEY=<CHANGE_ME>
# Crear el paciente en el CRM Odontoking en el primer contacto (path sofo-crm).
WHATSAPP_AUTO_CREATE_PERSON=true


# ── Odontoking - Tenant 1 (local, Bolivia) ──────────────────────────────────
# Credenciales Meta WhatsApp
WHATSAPP_PHONE_NUMBER_ID=<CHANGE_ME>
WHATSAPP_VERIFY_TOKEN=<CHANGE_ME>
WHATSAPP_ACCESS_TOKEN=<CHANGE_ME>
# Webhook URL a configurar en Meta Developer App:
#   https://TU-DOMINIO/api/v1/whatsapp/odontoking/webhook
#   (Legacy: /api/v1/whatsapp/webhook también funciona como alias)

# Sofopolis CRM
ODONTOKING_API_URL=https://odontoking.sofopolis.com
ODONTOKING_API_TOKEN=<CHANGE_ME>


# ── Kohlberg - Tenant 2 (nacional, Bolivia) ─────────────────────────────────
# Descomentar cuando se onboardee Kohlberg.
# Alternativa: crear el tenant via POST /api/v1/admin/tenants (sin redeploy)
#
# KOHLBERG_PHONE_NUMBER_ID=<CHANGE_ME>
# KOHLBERG_VERIFY_TOKEN=<CHANGE_ME>
# KOHLBERG_ACCESS_TOKEN=<CHANGE_ME>
# Webhook URL a configurar en Meta Developer App:
#   https://TU-DOMINIO/api/v1/whatsapp/kohlberg/webhook
#
# KOHLBERG_API_URL=https://kohlberg.sofopolis.com
# KOHLBERG_API_TOKEN=<CHANGE_ME>


# ── Langfuse (trazabilidad LLM) ──────────────────────────────────────────────
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY=<CHANGE_ME>
LANGFUSE_SECRET_KEY=<CHANGE_ME>
LANGFUSE_HOST=https://cloud.langfuse.com


# ── Alertas por email (SMTP SSL) ─────────────────────────────────────────────
# Se envía un email por cada logger.error() / logger.exception() (debounce 5 min)
MAIL_HOST=mail.sofopolis.com
MAIL_PORT=465                 # 465 = SSL directo | 587 = STARTTLS
MAIL_USERNAME=<CHANGE_ME>
MAIL_PASSWORD=<CHANGE_ME>
MAIL_FROM_ADDRESS=<CHANGE_ME>
MAIL_TO_ADDRESS=<CHANGE_ME>  # destinatario de las alertas (dev o equipo)
NOTIFICATION_COOLDOWN_SECONDS=300


# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json (producción) | console (desarrollo)
LOG_DIR=logs


# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT="200 per day,50 per hour"
RATE_LIMIT_CHAT="30 per minute"
RATE_LIMIT_CHAT_STREAM="20 per minute"
RATE_LIMIT_MESSAGES="50 per minute"
RATE_LIMIT_LOGIN="20 per minute"
RATE_LIMIT_REGISTER="10 per hour"


# ── Evaluación (Langfuse evals) ──────────────────────────────────────────────
EVALUATION_LLM=gpt-4o
EVALUATION_BASE_URL=https://api.openai.com/v1
EVALUATION_API_KEY=           # default: usa OPENAI_API_KEY si está vacío
EVALUATION_SLEEP_TIME=10


# ── Misceláneos ───────────────────────────────────────────────────────────────
SESSION_NAMING_ENABLED=true
SHAREMEDATA_API_URL=http://gamma.sharemedata.com:3000
SHAREMEDATA_API_KEY=
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0
